QUIETFEED_USERNAME=reader
QUIETFEED_PASSWORD=replace-with-a-long-random-password
QUIETFEED_SOCKET=/run/quietfeed/quietfeed.sock
QUIETFEED_DB=/var/lib/quietfeed/quietfeed.db
QUIETFEED_REFRESH_INTERVAL=20m
QUIETFEED_READ_RETENTION=2160h
QUIETFEED_FETCH_TIMEOUT=20s
QUIETFEED_INITIAL_ITEMS=20
QUIETFEED_MAX_ITEMS=1000
QUIETFEED_MAX_FEED_BYTES=10485760
QUIETFEED_ALLOW_PRIVATE_FEEDS=false
